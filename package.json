  "repository": "vorg/geom-normals",
  "license": "MIT",
  "author": "Marcin Ignac <marcin.ignac@gmail.com> (https://github.com/vorg)",
  "contributors": [
    "Damien Seguin (https://github.com/dmnsgn)"
  ],
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    }
  },
  "main": "./index.js",
  "types": "./types/index.d.ts",
  "scripts": {
    "dev": "snowdev dev",
    "release": "snowdev release"
  },
  "dependencies": {
